{
  "name": "demo-vote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "pretest": "node -e \"require('node:fs').mkdirSync('dist/client', { recursive: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply demo-vote-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply demo-vote-db --remote",
    "contrast": "node scripts/check-contrast.mjs",
    "check": "npm run typecheck && npm run contrast && npm run test && npm run build",
    "check:worker": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "smoke": "node scripts/smoke.mjs",
    "qr": "node scripts/qr.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.16.1",
    "@cloudflare/vitest-pool-workers": "^0.9.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "~3.2.4",
    "wrangler": "^4.115.0"
  }
}
